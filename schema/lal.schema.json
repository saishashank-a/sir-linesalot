{
  "$id": "urn:sir-linesalot:lal:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "lal"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "plates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plate"
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "title",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "title": "Sir Linesalot document (.lal), version 1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "layout": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "RIGHT",
            "DOWN",
            "LEFT",
            "UP"
          ]
        },
        "spacing": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "step",
            "note"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "ellipse",
            "diamond",
            "pill"
          ]
        },
        "plate": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "link": {
          "type": "object",
          "properties": {
            "plate": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "plate"
          ],
          "additionalProperties": false
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "fillStyle": {
          "type": "string",
          "enum": [
            "none",
            "hachure",
            "solid",
            "zigzag",
            "cross-hatch",
            "dots"
          ]
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "dashed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ink",
            "paper",
            "red",
            "orange",
            "yellow",
            "green",
            "teal",
            "blue",
            "violet",
            "pink",
            "gray"
          ]
        },
        {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      ]
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cardField"
          }
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "target",
        "fields"
      ],
      "additionalProperties": false
    },
    "cardField": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "plain",
            "url"
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "edges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "name",
        "nodes"
      ],
      "additionalProperties": false
    },
    "plate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "overview",
            "detail"
          ]
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "required": [
        "id",
        "name",
        "nodes"
      ],
      "additionalProperties": false
    }
  }
}
