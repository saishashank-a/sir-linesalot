{
  "name": "sir-linesalot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "schema": "node scripts/gen-schema.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "licenses": "node scripts/gen-licenses.ts",
    "plugin": "rolldown scripts/repo-diagram.ts scripts/ingest.ts --platform node --format esm --minify -d plugin/scripts --entry-file-names '[name].mjs' && rolldown src/model/validate.ts --platform node --format esm --minify -o api/_lib/validate.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vercel/blob": "^2.8.2",
    "@xyflow/react": "^12.12.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
